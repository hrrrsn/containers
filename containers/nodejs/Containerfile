FROM quay.io/fedora/fedora:46@sha256:dea8962dbcab334036946698c513d18a6dff49c4ce63765353018a899bce9f89

LABEL org.opencontainers.image.source=https://github.com/hrrrsn/containers
LABEL org.opencontainers.image.description="Fedora image with Node.js and Git"

RUN yum -y upgrade && \
    yum -y install \
    vim nano less wget rsync nodejs npm git openssh-clients \
    && yum clean all